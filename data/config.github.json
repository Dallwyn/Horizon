{
  "ai": {
    "provider": "gemini",
    "model": "gemini-3.7-flash",
    "api_key_env": "GOOGLE_API_KEY",
    "temperature": 0.3,
    "max_tokens": 8192,
    "throttle_sec": 4.5,
    "languages": ["de"],
    "analysis_concurrency": 1,
    "enrichment_concurrency": 1
  },
  "processing": {
    "profiles_dir": "profiles",
    "default_profile": "tech-news",
    "profile_settings": {
      "tech-news": {
        "threshold": 7.0,
        "topic_dedup": true
      }
    }
  },
  "extractors": {
    "full-text": {
      "type": "trafilatura",
      "favor_precision": true
    }
  },
  "sources": {
    "hackernews": {
      "enabled": false
    },
    "reddit": {
      "enabled": false
    },
    "telegram": {
      "enabled": false
    },
    "rss": [
      {
        "name": "Julian Ivanov | KI-Automatisierung",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCdoTbckiMelGtWvGMfhlkgQ",
        "enabled": true,
        "category": "youtube-ai",
        "profile": "tech-news"
      },
      {
        "name": "Everlast AI",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UC8T5gQ4U4GbI2h8kYCkEcvg",
        "enabled": true,
        "category": "youtube-ai",
        "profile": "tech-news"
      },
      {
        "name": "Y Combinator",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCcefcZRL2oaA_uBNeo5UOWg",
        "enabled": true,
        "category": "youtube-ai",
        "profile": "tech-news"
      },
      {
        "name": "Nate Herk | AI Automation",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UC2ojq-nuP8ceeHqiroeKhBA",
        "enabled": true,
        "category": "youtube-ai",
        "profile": "tech-news"
      },
      {
        "name": "AI Impact",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCnNA2EuEVybpo3WGEace4HQ",
        "enabled": true,
        "category": "youtube-ai",
        "profile": "tech-news"
      },
      {
        "name": "Christoph Magnussen",
        "url": "https://www.youtube.com/feeds/videos.xml?channel_id=UCDx6L69jmKBJbNu5GnkCilg",
        "enabled": true,
        "category": "youtube-ai",
        "profile": "tech-news"
      },
      {
        "name": "OpenAI News",
        "url": "https://openai.com/news/rss.xml",
        "enabled": true,
        "category": "official-ai",
        "profile": "tech-news",
        "content_extractor": "full-text"
      },
      {
        "name": "Google DeepMind Blog",
        "url": "https://deepmind.google/blog/rss.xml",
        "enabled": true,
        "category": "official-ai",
        "profile": "tech-news",
        "content_extractor": "full-text"
      }
    ],
    "anthropic": {
      "enabled": true,
      "url": "https://www.anthropic.com/news",
      "max_items": 20,
      "content_extractor": "full-text",
      "category": "official-ai",
      "profile": "tech-news"
    }
  },
  "collection": {
    "time_window_hours": 24
  },
  "digest": {
    "max_items": 25,
    "profile_order": ["tech-news"]
  },
  "email": {
    "enabled": true,
    "smtp_server": "smtp.gmail.com",
    "smtp_port": 465,
    "smtp_username": "kherank@googlemail.com",
