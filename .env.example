# Environment Variables
#
# This fork is configured for a single provider (Gemini) and a single
# delivery channel (email). See README.horizon-fork.md for the full setup.

# Gemini API key. Get one for free at https://aistudio.google.com/apikey
GOOGLE_API_KEY=xxx

# Gmail app password for the sending mailbox configured in
# data/config.github.json's email.email_address. Requires 2FA enabled on
# the Google account; generate at https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=xxx
